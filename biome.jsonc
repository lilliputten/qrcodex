// ex: set ft=jsonc :
{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.vscode",
      "!.utils",
      "!dist",
      "!build",
      "!public",
    ],
  },
  "formatter": {
    "enabled": true,
    "lineEnding": "lf",
    "indentStyle": "space",
    "indentWidth": 2,
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
    },
  },
  "json": {
    "parser": {
      "allowTrailingCommas": true,
    },
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useTemplate": "off",
      },
      "suspicious": {
        "noDebugger": "warn",
      },
      "correctness": {
        "noUnusedVariables": "warn",
      },
    },
    "domains": {
      "next": "recommended",
      "react": "recommended",
    },
  },
  "assist": {
    "actions": {
      "source": {
        // @see https://biomejs.dev/assist/actions/organize-imports/javascript/
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic",
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@/**", "!./**"],
              ":BLANK_LINE:",
              "@/**",
              ":BLANK_LINE:",
              "./**",
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"],
            ],
          },
        },
      },
    },
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
    },
    "globals": [
      "describe",
      "it",
      "expect",
      "jest",
      "beforeEach",
      "afterEach",
      "beforeAll",
      "afterAll",
    ],
  },
  "overrides": [
    {
      "includes": ["*.jsonc", ".vscode/*.json"],
      "json": {
        "parser": {
          "allowTrailingCommas": true,
        },
        "formatter": {
          "trailingCommas": "all",
        },
      },
    },
    {
      "includes": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
          },
          "suspicious": {
            "noDebugger": "off",
          },
        },
      },
    },
  ],
}
