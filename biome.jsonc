// ex: set ft=jsonc :
{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!.vscode",
      "!.utils",
      "!dist",
      "!build",
      "!public"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineEnding": "lf",
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noDebugger": "warn"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        // @see https://biomejs.dev/assist/actions/organize-imports/javascript/
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic",
            "groups": [
              [":BUN:", ":NODE:"],
              ":BLANK_LINE:",
              [":PACKAGE:", "!@/**", "!./**"],
              ":BLANK_LINE:",
              "@/**",
              ":BLANK_LINE:",
              "./**",
              ":BLANK_LINE:",
              [":ALIAS:", ":PATH:"]
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
  // "overrides": [
  //   {
  //     "includes": ["src/**/*.js"],
  //     "linter": {
  //       "rules": {
  //         "suspicious": {
  //           "noDebugger": "warn" // This re-enables the rule for JS files
  //         }
  //       }
  //     }
  //   }
  // ]
}
